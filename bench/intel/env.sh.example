# bench/intel/env.sh.example -- copy to bench/intel/env.sh and set CC.
#
# cp bench/intel/env.sh.example bench/intel/env.sh
# $EDITOR bench/intel/env.sh
#
# CC is required and must be GCC. Everything else has a default, and the
# defaults for RUNS and WARMUP match the RISC-V methodology.

# Compiler used to build the benchmark.
CC="gcc-14"

# Machine name for the summary's machine column; defaults to the CPU model.
# MACHINE="Intel Xeon 6787P"

# Timed runs and warmups.
# RUNS=10
# WARMUP=3

# First core. Single-thread cells run here; a T-thread run uses T physical
# cores starting here, one hardware thread each. Must be the first hardware
# thread of its core.
# PIN_CORE=0

# Enable user-space cycle/instruction counters.
# PERF=1

# Randomize experiment order within each matrix.
# SHUFFLE=1
# SHUF_SEED=1

# Retry incomplete or invalid runs.
# RETRIES=1

# Do not set the CPU governor to performance.
# NO_GOVERNOR=1

# Output directory and raw CSV.
# OUT_DIR="bench/intel/results"
# CSV="$OUT_DIR/spgemm_raw.csv"

# Re-run completed configurations.
# FORCE=1

# Run only the named real matrix.
# ONLY_MTX=cage12
